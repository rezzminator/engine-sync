{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "engine-sync agent frontmatter",
  "description": "The YAML frontmatter of a Claude agent source as engine-sync reads it. Keys outside Claude Code's native sub-agent keys, engine-sync's own keys and agents.passthroughKeys warn UNKNOWN-KEY.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The agent name; the Codex role and OpenCode agent use it verbatim."
    },
    "description": {
      "type": "string"
    },
    "tools": {
      "description": "A comma-separated string or a list of tool names.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "model": {
      "type": "string",
      "description": "A model alias, mapped per engine by codex.modelMap and opencode.modelMap."
    },
    "effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "description": "Codex receives max as xhigh."
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "description": "Capabilities the host must have for the agent to be linked or emitted."
    },
    "role": {
      "type": "string",
      "description": "Stamped by the declaration renderer only; a source carrying it is a problem."
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codex": {
          "oneOf": [
            {
              "const": false
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "A codex.modelMap key is mapped; any other value is emitted verbatim."
                },
                "effort": {
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                },
                "sandbox": {
                  "enum": [
                    "inherit",
                    "read-only",
                    "workspace-write"
                  ]
                }
              }
            }
          ]
        },
        "opencode": {
          "oneOf": [
            {
              "const": false
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "An opencode.modelMap key is mapped; any other value is emitted verbatim."
                },
                "mode": {
                  "enum": [
                    "all",
                    "primary",
                    "subagent"
                  ]
                },
                "permission": {
                  "type": "object",
                  "description": "Rendered as the agent's OpenCode permission."
                }
              }
            }
          ]
        }
      }
    },
    "from": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Machine declaration base: an original, declaration or general-purpose. The file base equals name."
    },
    "extends": {
      "type": "array",
      "description": "Shared files layered in order, each a path relative to the declaring file naming a .md below a subdirectory of the agents directory.",
      "items": {
        "type": "string",
        "pattern": "^[^/\\\\][^\\\\]*\\.md$"
      }
    },
    "add": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "array"
          },
          {
            "type": "object"
          }
        ]
      },
      "properties": {
        "tools": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      }
    },
    "unset": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rename": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "prepend": {
      "type": "string"
    },
    "append": {
      "type": "string"
    },
    "pins": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "retitle": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "codex-model"
        ]
      },
      {
        "required": [
          "codex-effort"
        ]
      },
      {
        "required": [
          "codex-sandbox"
        ]
      },
      {
        "required": [
          "opencode-model"
        ]
      },
      {
        "required": [
          "opencode-mode"
        ]
      }
    ]
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "required": [
          "from"
        ]
      },
      "then": {
        "required": [
          "name"
        ]
      }
    }
  ]
}
